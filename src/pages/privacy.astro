---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../../site.config.mjs';
// Have a lawyer review this before launch, and update it if you add analytics, forms or new vendors.
const updated = 'December 1, 2026';
---
<BaseLayout title="Privacy" description="What Breakglass Labs collects through this website and how it is used.">
  <section class="page-hero grid-bg">
    <div class="container">
      <p class="label">Privacy</p>
      <h1 class="h1">Privacy notice</h1>
      <p class="mono small muted">Last updated {updated}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="prose">
        <p>This notice covers this website. Client engagements are covered by the agreements we sign with each client, including any data processing or business associate terms.</p>

        <h2>What we collect</h2>
        <ul>
          <li><strong>What you send us.</strong> If you email us or book a call, we receive your name, email address and whatever you choose to tell us.</li>
          <li><strong>Server logs.</strong> Our hosting provider, Cloudflare, processes standard request data such as IP addresses and browser details to deliver the site and protect it from abuse.</li>
          <li><strong>Scheduling.</strong> If you book a call, the scheduling service we use processes your booking under its own privacy policy.</li>
        </ul>
        <p>This site sets no advertising or tracking cookies and runs no third-party analytics scripts.</p>

        <h2>How we use it</h2>
        <p>We use what you send us to reply, to scope and deliver work you ask for, and to keep business records. We do not sell personal information, and we do not use it for advertising.</p>

        <h2>How long we keep it</h2>
        <p>We keep correspondence for as long as it is useful for the conversation or the engagement, and as long as tax, legal or contractual obligations require.</p>

        <h2>Your choices</h2>
        <p>You can ask us what we hold about you, ask us to correct it, or ask us to delete it, by emailing <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>

        <h2>Contact</h2>
        <p>{SITE.legalName}, {SITE.location}. Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
